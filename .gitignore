# Dependencies
/node_modules

# Next.js build output (reproducible)
/.next
/out
/build
*.tsbuildinfo
next-env.d.ts

# Secrets and local environment. `.env.example` is tracked on purpose.
.env*
!.env.example

# Runtime backup of the admin CMS store. `writeStore` recreates it on every
# admin save (temp + rename + copyFile), so it is output, not source — and it
# carries whatever `settings.adminPasswordHash` held at the previous save.
/data/admin/store.json.bak

# Local object storage and databases (real uploaded documents live here)
/.storage
*.db
*.db-journal
*.sqlite
*.sqlite3

# Hand-made pre-Git snapshots of older trees. Not source; vitest already
# excludes them from collection.
/.billing-backup-*
/.csrf-backup-*

# Probe and QA artifacts (regenerated by the probes)
/qa-screenshots
/docs/screenshots
/responsive-qa-report.json

# OS / editor noise
.DS_Store
npm-debug.log*
