# Dependencies
/node_modules

# Next.js build output (reproducible)
/.next
/out
/build
*.tsbuildinfo
next-env.d.ts

# Secrets and local environment. `.env.example` is tracked on purpose.
.env*
!.env.example

# Runtime backup of the admin CMS store. `writeStore` recreates it on every
# admin save (temp + rename + copyFile), so it is output, not source — and it
# carries whatever `settings.adminPasswordHash` held at the previous save.
/data/admin/store.json.bak

# Local object storage and databases (real uploaded documents live here)
/.storage
*.db
*.db-journal
*.sqlite
*.sqlite3

# Hand-made pre-Git snapshots of older trees. Not source; vitest already
# excludes them from collection.
/.billing-backup-*
/.csrf-backup-*

# Suite-evidence bulk output. Each run of `scripts/suite-evidence.mjs` writes four
# files; the `.summary.json` is the RECORD (seed, worker count, machine, counts,
# every failure with its stack, the 15 slowest tests) and IS committed. The verbose
# log, the raw vitest JSON and the JUnit XML are ~6MB per leg and reproducible from
# the exact `command` string each summary carries, so they stay local. The failing
# leg additionally keeps a trimmed `*.failures.log`.
/docs/evidence/final-prelaunch/suite/*.log
!/docs/evidence/final-prelaunch/suite/*.failures.log
/docs/evidence/final-prelaunch/suite/*.json
!/docs/evidence/final-prelaunch/suite/*.summary.json
/docs/evidence/final-prelaunch/suite/*.junit.xml

# Same rule, same reason, for the production-acceptance legs.
/docs/evidence/production-acceptance/suite/*.log
!/docs/evidence/production-acceptance/suite/*.failures.log
/docs/evidence/production-acceptance/suite/*.json
!/docs/evidence/production-acceptance/suite/*.summary.json
/docs/evidence/production-acceptance/suite/*.junit.xml

# Probe and QA artifacts (regenerated by the probes)
/qa-screenshots
/docs/screenshots
/responsive-qa-report.json

# OS / editor noise
.DS_Store
npm-debug.log*
