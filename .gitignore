# Dependencies
/node_modules

# Next.js build output (reproducible)
/.next
/out
/build
*.tsbuildinfo
next-env.d.ts

# Secrets and local environment. `.env.example` is tracked on purpose.
.env*
!.env.example

# Local object storage and databases (real uploaded documents live here)
/.storage
*.db
*.db-journal
*.sqlite
*.sqlite3

# Hand-made pre-Git snapshots of older trees. Not source; vitest already
# excludes them from collection.
/.billing-backup-*
/.csrf-backup-*

# Probe and QA artifacts (regenerated by the probes)
/qa-screenshots
/docs/screenshots
/responsive-qa-report.json

# OS / editor noise
.DS_Store
npm-debug.log*
