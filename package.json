{
  "name": "pdfdadi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "predev": "prisma generate",
    "build": "prisma generate && node scripts/next-build.js",
    "start": "node ingress/server.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:export-fidelity": "tsx scripts/export-fidelity-probe.mts",
    "worker": "tsx src/workers/processingWorker.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "usage:readiness": "tsx scripts/usage-readiness.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "framer-motion": "11.18.2",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.1",
    "lucide-react": "0.474.0",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "22.10.10",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.5.5",
    "eslint": "^10.8.0",
    "postcss": "8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.1",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
